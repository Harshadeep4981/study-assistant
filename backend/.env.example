# Groq API Key (optional for startup, required for AI endpoints)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default verified working model)
GROQ_MODEL=qwen/qwen3.8-27b

# CORS Allowed Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Document Ingestion Resource Limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=100

# AI Generation Settings
# Direct generation input limit (default: 100 KB = 102400 bytes). Inputs up to this size proceed directly.
MAX_GENERATION_INPUT_BYTES=102400

# Large-document processing capacity limit (default: 500 KB = 512000 bytes).
# Inputs between MAX_GENERATION_INPUT_BYTES and MAX_LARGE_DOCUMENT_BYTES undergo semantic chunking
# and hierarchical summarization before generation. Inputs exceeding this limit are rejected with HTTP 413.
MAX_LARGE_DOCUMENT_BYTES=512000
# Optional: Raw request body limit for generation endpoints.
# When unset (recommended), the limit is automatically derived as (6 * MAX_LARGE_DOCUMENT_BYTES + 32 KB).
# Only uncomment and set if deliberately overriding the derived default. Any explicit value
# must be >= (6 * MAX_LARGE_DOCUMENT_BYTES + 32 KB) to guarantee safe JSON serialization.
# MAX_GENERATION_REQUEST_BODY_BYTES=3104768
AI_MAX_RETRIES=2

# Provider transport retry and rate-limit backoff (separate from malformed-output retries)
AI_PROVIDER_RATE_LIMIT_MAX_RETRIES=5
AI_PROVIDER_TRANSIENT_MAX_RETRIES=2
AI_PROVIDER_BACKOFF_INITIAL_SECONDS=1.0
AI_PROVIDER_BACKOFF_MULTIPLIER=2.0
AI_PROVIDER_BACKOFF_MAX_SECONDS=16.0
AI_PROVIDER_TRANSIENT_BACKOFF_INITIAL_SECONDS=0.5
AI_PROVIDER_TRANSIENT_BACKOFF_MAX_SECONDS=2.0

# Shared per-process request pacing and rate-limit circuit breaker
AI_PROVIDER_MIN_REQUEST_INTERVAL_SECONDS=0.25
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0

# Request-Level Processing Budgets & Guardrails
# Maximum total Groq API attempts per request across chunking, consolidation, and generation.
# Sized to accommodate MAX_LARGE_DOCUMENT_BYTES (500 KB: 69 chunk ops + 17 L2 + 5 L3 + 1 final synthesis = 92 base ops + 1 generation = 93 base calls, leaving 27 retries within 120).
AI_MAX_REQUEST_CALLS=120
# Maximum total processing duration in seconds per request across all steps before termination (default: 300.0s = 5 minutes).
AI_REQUEST_TIMEOUT_SECONDS=300.0
# Maximum summarization and consolidation operations allowed per request.
# Sized to accommodate MAX_LARGE_DOCUMENT_BYTES (500 KB: 69 chunk ops + 17 L2 + 5 L3 + 1 final synthesis = 92 operations, <= 100).
AI_MAX_SUMMARIZATION_OPERATIONS=100

# Server
HOST=0.0.0.0
PORT=8000
